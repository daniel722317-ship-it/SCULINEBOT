# 複製這份成 .env，填入實際值
# .env 已經被 .gitignore 排除，不會被 commit

# Google Gemini API 金鑰
# 取得：https://aistudio.google.com/apikey
# 免費方案：gemini-3.1-flash-lite 每天 1500 次，每分鐘 15 次
GEMINI_API_KEY=

# LINE Messaging API channel
# 取得：https://developers.line.biz/console/ → 你的 Provider → Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase 專案
# 取得：https://supabase.com/dashboard → 你的 Project → Project Settings → API
SUPABASE_URL=
SUPABASE_KEY=
