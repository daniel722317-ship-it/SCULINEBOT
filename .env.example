# 複製這份成 .env，填入實際值
# .env 已經被 .gitignore 排除，不會被 commit

# Anthropic Claude API 金鑰（fitness.py 用）
# 取得：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini API 金鑰（其他課程範例 .py 用，fitness.py 不需要）
# 取得：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LINE Messaging API channel
# 取得：https://developers.line.biz/console/ → 你的 Provider → Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase 專案
# 取得：https://supabase.com/dashboard → 你的 Project → Project Settings → API
SUPABASE_URL=
SUPABASE_KEY=
